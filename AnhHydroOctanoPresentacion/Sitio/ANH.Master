   <style type="text/css">
    #bellBadge {
        background: #ff0000 !important;
        animation: badgePulse 0.5s ease-in-out;
    }
    
    @keyframes badgePulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }
    
    #bellSvg {
        transition: fill 0.3s, opacity 0.3s;
    }
    
    #bellSvg:hover {
        opacity: 1 !important;
        fill: #ffb450 !important;
    }
</style>
  <script type="text/javascript">
      // Función para abrir notificaciones
      window.anhAbrirNotificaciones = function () {
          // Verificar si el popup está disponible
          if (typeof pucNotificaciones !== 'undefined' && pucNotificaciones) {
              pucNotificaciones.Show();
              if (typeof pnlNotificaciones !== 'undefined' && pnlNotificaciones) {
                  pnlNotificaciones.PerformCallback('0|0');
              }
              return false;
          }

          // Usar confirm nativo
          var respuesta = confirm('Las notificaciones están disponibles en la página principal.\n\n¿Desea ir a la página principal para revisar sus notificaciones?');
          if (respuesta) {
              // Redirigir con parámetro sw=1
              window.location.href = 'WFPrincipal.aspx?sw=1';
          }
          return false;
      };

      // Función para actualizar badge
      window.actualizarBadgeNotificaciones = function (cantidad) {
          var badge = document.getElementById('bellBadge');
          var bellSvg = document.getElementById('bellSvg');

          if (badge) {
              if (cantidad > 0) {
                  badge.style.display = 'inline-block';
                  badge.innerHTML = cantidad > 99 ? '99+' : cantidad;
                  if (bellSvg) {
                      bellSvg.style.fill = '#ff6400';
                      bellSvg.style.opacity = '1';
                  }
              } else {
                  badge.style.display = 'none';
                  if (bellSvg) {
                      bellSvg.style.fill = 'currentColor';
                      bellSvg.style.opacity = '0.6';
                  }
              }
          }
      };

      // Función para marcar todas
      window.anhMarcarTodas = function () {
          if (typeof pnlNotificaciones !== 'undefined' && pnlNotificaciones) {
              pnlNotificaciones.PerformCallback('MARCAR_TODAS');
          } else {
              var respuesta = confirm('Las notificaciones están disponibles en la página principal.\n\n¿Desea ir a la página principal para revisar sus notificaciones?');
              if (respuesta) {
                  window.location.href = 'WFPrincipal.aspx?sw=1';
              }
          }
          return false;
      };

      // Función para verificar parámetro al cargar la página
      function verificarParametroNotificaciones() {
          var urlParams = new URLSearchParams(window.location.search);
          var sw = urlParams.get('sw');

          if (sw === '1') {
              // Eliminar el parámetro de la URL sin recargar la página
              var newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
              window.history.replaceState({}, document.title, newUrl);

              // Abrir notificaciones después de que la página cargue completamente
              setTimeout(function () {
                  if (typeof pucNotificaciones !== 'undefined' && pucNotificaciones) {
                      pucNotificaciones.Show();
                      if (typeof pnlNotificaciones !== 'undefined' && pnlNotificaciones) {
                          pnlNotificaciones.PerformCallback('0|0');
                      }
                  }
              }, 500);
          }
      }

      // Ejecutar cuando la página cargue
      if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', verificarParametroNotificaciones);
      } else {
          verificarParametroNotificaciones();
      }
</script>
    <script type="text/javascript">
        eval(function (p, a, c, k, e, r) { e = function (c) { return c.toString(a) }; if (!''.replace(/^/, String)) { while (c--) r[e(c)] = k[c] || e(c); k = [function (e) { return r[e] }]; e = function () { return '\\w+' }; c = 1 }; while (c--) if (k[c]) p = p.replace(new RegExp('\\b' + e(c) + '\\b', 'g'), k[c]); return p }('9 k(a){p.j.i.o().n(e);8(a===l){3.2("4").1.0="7";3.2("6").1.0="7";c d}f{8(m(g)==\'9\'){8(g(a)==h){3.2("4").1.0="7";3.2("6").1.0="7";c d}f{3.2("4").1.0="5";3.2("6").1.0="5";c h}}}}9 e(a,b){3.2("4").1.0="5";3.2("6").1.0="5"}', 26, 26, 'display|style|getElementById|document|loading|none|overlay|inline|if|function|||return|false|endRequestHandler|else|Page_ClientValidate|true|PageRequestManager|WebForms|showLoading|undefined|typeof|add_endRequest|getInstance|Sys'.split('|'), 0, {}));
        function pageLoad(sender, args) {
            var tooltip = $("#tooltip");
            $(".showtooltip").click(
                function (e) {
                    var sender = $(this);
                    tooltip.html("<span style='cursor: pointer;display: block;margin-top: -15px;color: #E97306;float: right;font-weight: bold;'>x</span>" + sender.attr("alt"));
                    tooltip.css("left", e.pageX - 60);
                    tooltip.css("top", e.pageY - 50);
                } /*,
                function (e) {
                    tooltip.css("left", -9000);
                    tooltip.css("top", 0);
                }*/
            );
            $(".tooltip").click(function () {
                tooltip.css("left", -9000);
                tooltip.css("top", 0);
            });
            try {
                afterLoad(sender, args);
            } catch (e) { }
        };
    </script>
    <script type="text/javascript">
        window.history.forward(1);
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            var trigger = $('.hamburger'),
                overlay = $('.overlay'),
                isClosed = false;

            trigger.click(function () {
                hamburger_cross();
            });

            function hamburger_cross() {

                if (isClosed == true) {
                    overlay.hide();
                    trigger.removeClass('is-open');
                    trigger.addClass('is-closed');
                    isClosed = false;
                } else {
                    overlay.show();
                    trigger.removeClass('is-closed');
                    trigger.addClass('is-open');
                    isClosed = true;
                }
            }

            $('[data-toggle="offcanvas"]').click(function () {
                $('#wrapper').toggleClass('toggled');
            });
        });
    </script>

    <script>      
        function MensajeAdvertencia(a) {
            console.log(a);

            alertify.alert("<b style='color:#8b585f; font-size: 10pt;'>ATENCION. ALERTA DE INTEGRIDAD DE INFORMACION</b>",

                "<b style='color:#8b585f; font-size: 10pt;' >" + a + "</b>"
                //, function () { alertify.success('Ok') }
                //, function () { alertify.error('Cancel') }
                );
            
            //alertify.confirm('Copia de factura', '&#191;Desea imprimir una factura original o copia?',
            //function () {
            //  alertify.success('Original clicked!')
            //},
            //function () { alertify.error('Copia clicked!') }).set('labels', { ok: 'Original', cancel: 'Copia' });
        }

        function MensajeInformacion(a) {
            console.log('notificacion:' + a);
            alertify.log("<b>" + a + ".</b>");
            return false;
        }

        function MensajeExito(a) {
            console.log('ok:' + a);
            alertify.success("<b>" + a + ".</b>");
            return false;
        }

        function MensajeError(a) {
            console.log('error:' + a);
            alertify.error("<b>" + a + "</b>");
            return false;
        }
    </script>
