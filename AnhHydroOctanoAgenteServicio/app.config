      <basicHttpBinding>
        <binding name="HydroCoreSesionEndPoint">
          <security mode="Transport" />
        </binding>
        <binding name="HydroCoreConsultasEndPoint">
          <security mode="Transport" />
        </binding>
        <binding name="HydroCoreListadosEndPoint">
          <security mode="Transport" />
