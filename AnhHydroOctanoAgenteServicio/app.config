      <endpoint address="https://vsrvuid006.anh.gob.bo:8443/WSParametricas/ServicioParametricas.svc"
        binding="basicHttpBinding" bindingConfiguration="HydroParametricasEndPoint"
        contract="ServicioParametricas.IServicioParametricas" name="HydroParametricasEndPoint" />
      <endpoint address="https://vsrvuid013.anh.gob.bo:7443/WSCore/ServicioHydroSesion.svc"
        binding="basicHttpBinding" bindingConfiguration="HydroCoreSesionEndPoint"
        contract="ServicioHydroSesion.IServicioHydroSesion" name="HydroCoreSesionEndPoint" />
      <endpoint address="http://10.201.0.220:86/ServicioExternoInstitucion.svc"
        binding="basicHttpBinding" bindingConfiguration="httpBasicConfig"
        contract="ServicioExternoSegip.IServicioExternoInstitucion"
        name="httpBasicConfig" />
    </client>
  </system.serviceModel>
